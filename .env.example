# Copy to .env and adjust. docker compose reads .env automatically.

# Postgres password for the bundled database.
AICM_DB_PASSWORD=change-me

# URL your browser and agents use to reach the hub.
AICM_PUBLIC_URL=http://localhost:8080

# Host port for the hub.
AICM_PORT=8080

# debug, info, warn or error.
AICM_LOG_LEVEL=info

# Master key for stored secrets. By default the hub generates one into the
# hub-data volume on first start. BACK IT UP: losing it means re-entering
# every provider key. To supply your own: openssl rand -base64 32
# AICM_MASTER_KEY=

# uid:gid that owns the nightly backup files in ./backups (run `id -u`:`id -g`).
AICM_BACKUP_OWNER=
